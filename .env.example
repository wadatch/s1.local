# cp .env.example .env して使う。.env は git 管理外。

# ポータルを待ち受けるアドレス。
# ヘッドレスサーバなので 0.0.0.0 にしないと別マシンから見られない。
BIND_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# HTTPS を張る Tailscale の MagicDNS 名。
# ここに対しては本物の Let's Encrypt 証明書が発行されるので、
# 端末側に証明書をインストールする作業は要らない。
#
#   tailscale status --json | grep CertDomains
#
# で確認できる。`.local` 名には公的な証明書を発行できない（mDNS 用の
# 予約 TLD で所有を証明できないため）ので、HTTPS はこちらの名前で受ける。
TS_HOSTNAME=s1.tail981a3e.ts.net

# /api/status の結果をメモリに保持する秒数。
# 複数タブから開いても裏側への問い合わせが増えないようにするためのもの。
STATUS_CACHE_SECONDS=10

# 死活チェック 1 件あたりのタイムアウト秒数。
# 全サービスを並列にチェックするので、この値がトップページの最大待ち時間になる。
HEALTH_TIMEOUT_SECONDS=3
