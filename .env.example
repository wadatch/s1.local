# cp .env.example .env して使う。.env は git 管理外。

# ポータルを待ち受けるアドレス。
# ヘッドレスサーバなので 0.0.0.0 にしないと別マシンから見られない。
BIND_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# HTTPS を張る Tailscale の MagicDNS 名。
# ここに対しては本物の Let's Encrypt 証明書が発行されるので、
# 端末側に証明書をインストールする作業は要らない。
#
#   tailscale status --json | grep CertDomains
#
# で確認できる。`.local` 名には公的な証明書を発行できない（mDNS 用の
# 予約 TLD で所有を証明できないため）ので、HTTPS はこちらの名前で受ける。
TS_HOSTNAME=s1.tail981a3e.ts.net

# /api/status の結果をメモリに保持する秒数。
# 複数タブから開いても裏側への問い合わせが増えないようにするためのもの。
STATUS_CACHE_SECONDS=10

# 死活チェック 1 件あたりのタイムアウト秒数。
# 全サービスを並列にチェックするので、この値がトップページの最大待ち時間になる。
HEALTH_TIMEOUT_SECONDS=3

# --- 回線速度 ---------------------------------------------------------------
# name:interface を書いた順に測る。最初のものが基準のサーバを決める。
# インターフェース名は `ip -br addr` で確認する。
SPEED_LINKS=wired:eno1,wifi:wlp3s0

# 測定間隔（秒）。
#
# **この値は通信量と回線の占有時間に直結する。** 1 サイクルで有線・無線を
# 順に測り、実測でおよそ 50 秒・1.5〜2 GB を流す。つまり
#
#     1 日の通信量 ≒ 2 GB × 86400 / この値
#     回線が塞がる割合 ≒ 50 / この値
#
# 1800 秒（30 分）なら 1 日約 96 GB、30 分のうち 50 秒（約 3%）は
# 回線が測定で埋まる。時間帯ごとの変化を追える程度には細かく、
# 常時使っていて気になるほどではない、という兼ね合いでこの値にしている。
SPEED_INTERVAL_SECONDS=1800
SPEED_PORT=9800

# --- SwitchBot -------------------------------------------------------------
# 温湿度センサーの値をクラウド API から取るための認証情報。
#
# SwitchBot アプリ → プロフィール → 設定 → 「アプリバージョン」を 10 回連打
# → 開発者向けオプション → トークンを取得
#
# 温湿度計をクラウドに中継する SwitchBot ハブ（Hub Mini / Hub 2）が必要。
# 空のままだと exporter は起動時に終了する（ポータルの他の表示には影響しない）。
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# 取得間隔（秒）。SwitchBot API は 1 日 10,000 回までで、
#
#     1 日の消費回数 ≒ (センサー台数 + 1) × 86400 / この値
#
# 我が家は 32 台あるので、300 秒だと 1 日 9,500 回で上限の 95%。
# 再起動が数回入るだけで上限に達し、**全センサーが取れなくなる**。
# 600 秒なら約 4,750 回で半分以下に収まる。室温はこの間隔で十分追える。
# センサーを増やしたらこの値も見直すこと。
SWITCHBOT_POLL_SECONDS=600
